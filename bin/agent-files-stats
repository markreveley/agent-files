#!/usr/bin/env python3
"""agent-files-stats — trial measurement (md/docs/m1-build-spec.md §7.3). Standard library only."""
import argparse
import dataclasses
import datetime
import hashlib
import json
import os
import re
import statistics
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from agent_files import fsutil, git  # noqa: E402
from agent_files import thread as T  # noqa: E402


def trailers(body: str) -> dict:
    out = {}
    for ln in body.splitlines():
        if ln.startswith("Agent-Files-") and ": " in ln:
            k, v = ln.split(": ", 1)
            out[k] = v.strip()
    return out


def thread_path(tid: str) -> str:
    return f"threads/{tid}/thread.md"


def show(root, rev, path):
    r = git.run(root, "show", f"{rev}:{path}")
    return r.stdout if r.returncode == 0 else None


def body_up_to_last_end(text: str) -> str:
    th = T.parse(text)
    n = len(th.fm_raw)
    lines = text.split("\n")[n:]
    last = -1
    for t in th.turns:
        if t.closed != "none":
            last = max(last, t.end_line - n)
    return "\n".join(lines[: last + 1]) + ("\n" if last >= 0 else "")


ABNORMAL = ("failed", "interrupted", "conflict")


def settled(before: str, after: str) -> str:
    """The part of `before` that `after` must keep: its body up to the last END, minus agent turns
    that ended abnormally and are gone from `after`. Deleting a failed, interrupted or conflicted
    turn to retry it is not a context edit; editing one, or deleting a normal turn, still is."""
    b = T.parse(before)
    kept = {t.id for t in T.parse(after).turns if t.role == "agent"}
    turns = [t for t in b.turns if not (t.role == "agent" and t.closed in ABNORMAL and t.id not in kept)]
    if len(turns) < len(b.turns):
        before = dataclasses.replace(b, turns=turns).serialize()
    return body_up_to_last_end(before)


def keeps(before: str, after: str):
    """Whether `after` starts with the settled part of `before`; None if nothing is settled yet."""
    pre = settled(before, after)
    if not pre:
        return None
    a_body = "\n".join(after.split("\n")[len(T.parse(after).fm_raw):])
    return (a_body + "\n").startswith(pre) or a_body.startswith(pre)


def context_edited(before: str, after: str) -> bool:
    return keeps(before, after) is False


def classify(root, commit, tid, prev=None):
    """`prev` is (commit, path) of the thread's last version under an earlier name, if it was renamed."""
    path = thread_path(tid)
    after = show(root, commit, path)
    before = show(root, commit + "^", path)
    if before is None and prev:              # first send under a new name: compare with the old one
        before = show(root, *prev)
    if after is None or before is None:
        return None
    b, a = T.parse(before), T.parse(after)
    kinds = set()
    if context_edited(before, after):
        kinds.add("context_edit")
    if b.frontmatter.get("model") != a.frontmatter.get("model"):
        kinds.add("model_switch")
    elif b.frontmatter != a.frontmatter:
        kinds.add("frontmatter_edit")
    return kinds


def fork_identity(th):
    """What a fork was started with: carry, branch point, first turn. Survives a rename or move."""
    first = next((t.body.strip() for t in th.turns if t.role == "you"), "")
    return ((th.carry or "").strip(), str(th.frontmatter.get("branched_at") or ""), first)


def blob_id(path: str) -> str:
    with open(path, "rb") as f:
        data = f.read()
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def history(root):
    """One pass over first-parent history of threads/. Per thread id: (index, commit) of the first
    commit adding its thread.md and of the last one where it had content, and the blob ids of the
    steps/*.request.json files ever committed under it."""
    out = git.run(root, "-c", "core.quotePath=false", "log", "--reverse", "--first-parent", "--no-renames",
                  "--raw", "--no-abbrev", "--format=%x1e%H", "--", "threads").stdout
    first, last, reqs = {}, {}, {}
    for i, rec in enumerate(out.split("\x1e")[1:]):
        lines = rec.split("\n")
        for ln in lines[1:]:
            if not ln.startswith(":") or "\t" not in ln:
                continue
            meta, path = ln.split("\t", 1)
            meta = meta.split()
            if meta[4].startswith("D") or not path.startswith("threads/") or path.startswith("threads/_observed"):
                continue
            rel = path[len("threads/"):]
            if rel.endswith("/thread.md"):
                tid = rel[:-len("/thread.md")]
                first.setdefault(tid, (i, lines[0]))
                last[tid] = (i, lines[0])
            elif "/steps/" in rel and rel.endswith(".request.json"):
                reqs.setdefault(rel.rsplit("/steps/", 1)[0], set()).add(meta[3])
    return first, last, reqs


def renames(root, dirs, first, last, reqs):
    """Map each thread id that no longer exists to the id it was renamed or moved to. The runner
    commits only the current thread's paths, so git never records the rename; the link is by
    content instead. The new id first appears after the old id's last commit and either holds a
    request.json committed under the old id (renaming a directory moves its steps/ along), or,
    failing that, keeps the old body up to its last END (as in §7.2). Links are one-to-one. A
    thread never committed under its new name is read from disk."""
    start = {t: first[t][0] if t in first else float("inf") for t in set(first) | set(dirs)}
    order = sorted(start, key=lambda t: (start[t], t))
    texts = {}

    def first_text(t):
        if t not in texts:
            if t in first:
                texts[t] = show(root, first[t][1], thread_path(t))
            else:
                try:
                    with open(os.path.join(dirs[t], "thread.md"), encoding="utf-8") as f:
                        texts[t] = f.read()
                except OSError:
                    texts[t] = None
        return texts[t]

    for t in dirs:
        if t not in first:
            steps = os.path.join(dirs[t], "steps")
            names = os.listdir(steps) if os.path.isdir(steps) else []
            reqs[t] = {blob_id(os.path.join(steps, n)) for n in names if n.endswith(".request.json")}
    absent = [a for a in order if a not in dirs and a in last]
    olds = {a: show(root, last[a][1], thread_path(a)) for a in absent}
    nxt, taken = {}, set()
    for by_steps in (True, False):           # a shared request.json is the stronger link: try it first
        for a in absent:
            if a in nxt:
                continue
            for b in order:
                if start[b] <= last[a][0] or b in taken:
                    continue
                if by_steps:
                    linked = bool(reqs.get(a, set()) & reqs.get(b, set()))
                else:
                    linked = bool(olds[a] and first_text(b) and keeps(olds[a], first_text(b)))
                if linked:
                    nxt[a] = b
                    taken.add(b)
                    break
    return nxt


def since_arg(since: str) -> str:
    """git reads a bare YYYY-MM-DD as that date at the current time of day; make it local midnight."""
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", since):
        return datetime.datetime.strptime(since, "%Y-%m-%d").astimezone().isoformat()
    return since


def final(nxt, tid):
    while tid in nxt:
        tid = nxt[tid]
    return tid


def compute(root, since=None):
    res = {}
    has_git = os.path.isdir(os.path.join(root, ".git"))
    threads, dirs = [], {}
    for tid, d, bad in fsutil.list_threads(root):
        try:
            threads.append((tid, T.parse_file(os.path.join(d, "thread.md"))))
            dirs[tid] = d
        except OSError:
            pass
    nturns = {tid: len([t for t in th.turns if t.role in ("you", "agent") and t.body.strip()]) for tid, th in threads}
    forks_now = [tid for tid, th in threads if th.frontmatter.get("kind") == "fork"]
    # deleted forks, from history
    deleted_forks = 0
    sends = []
    nxt, prev, last = {}, {}, {}
    if has_git:
        fmt = "%H%x1f%aI%x1f%s%x1f%b%x1e"
        args = ["log", "--reverse", "--first-parent", f"--format={fmt}"]
        if since:
            args.append(f"--since={since_arg(since)}")
        out = git.run(root, *args).stdout
        for rec in out.split("\x1e"):
            rec = rec.strip("\n")
            if not rec:
                continue
            h, when, subj, body = rec.split("\x1f", 3)
            tr = trailers(body)
            if tr.get("Agent-Files-Event") == "send":
                sends.append((h, tr["Agent-Files-Thread"]))
        first, last, reqs = history(root)
        nxt = renames(root, dirs, first, last, reqs)
        prev = {b: a for a, b in nxt.items()}
        known = {fork_identity(th) for tid, th in threads if tid in forks_now}   # renamed forks are not deleted
        gone = set()
        for tid in sorted(first, key=lambda t: first[t]):
            end = final(nxt, tid)
            if end in dirs or end in gone:   # renamed to a thread that exists, or already counted
                continue
            gone.add(end)
            txt = show(root, first[tid][1], thread_path(tid))
            if not txt:
                continue
            old = T.parse(txt)
            if old.frontmatter.get("kind") == "fork" and fork_identity(old) not in known:
                known.add(fork_identity(old))
                deleted_forks += 1
    edit_threads, switch_count = set(), 0
    for h, tid in sends:
        p = prev.get(tid)
        kinds = classify(root, h, tid, (last[p][1], thread_path(p)) if p else None)
        if not kinds:
            continue
        if "context_edit" in kinds:
            edit_threads.add(final(nxt, tid))    # under the thread's current name
        if "model_switch" in kinds:
            switch_count += 1
    counts = sorted(nturns.values())
    six = [tid for tid, n in nturns.items() if n >= 6]
    six_edited = len([t for t in six if t in edit_threads])
    carry_sizes = [(th.carry or "") for tid, th in threads if th.carry]
    # spend
    total_spend = today_spend = 0.0
    today = time.strftime("%Y-%m-%d")
    for dirpath, _, files in os.walk(os.path.join(root, "threads")):
        if os.path.basename(dirpath) != "steps":
            continue
        for fn in files:
            if fn.endswith(".response.json"):
                p = os.path.join(dirpath, fn)
                try:
                    c = float(json.load(open(p)).get("cost_usd") or 0)
                except (OSError, ValueError):
                    continue
                total_spend += c
                if time.strftime("%Y-%m-%d", time.localtime(os.path.getmtime(p))) == today:
                    today_spend += c
    def lines_of(p):
        try:
            return [l for l in open(os.path.join(root, p), encoding="utf-8").read().split("\n") if l.strip()]
        except OSError:
            return []
    obs = [l.split("\t") for l in lines_of("trial/observed.log")]
    res.update({
        "threads": len(threads),
        "forks": len(forks_now) + deleted_forks,
        "turns_median": statistics.median(counts) if counts else 0,
        "turns_max": counts[-1] if counts else 0,
        "threads_6plus": len(six),
        "threads_6plus_with_context_edit": six_edited,
        "threads_with_context_edit": len(edit_threads),
        # cut, not rounded, to one decimal: a share below 5% or 20% never prints as reaching it
        "context_edit_pct": (1000 * six_edited // len(six)) / 10 if six else 0.0,
        "carry_median_lines": statistics.median([c.count("\n") + 1 for c in carry_sizes]) if carry_sizes else 0,
        "carry_median_chars": statistics.median([len(c) for c in carry_sizes]) if carry_sizes else 0,
        "model_switches": switch_count,
        "searches": len(lines_of("trial/searches.log")),
        "observed_sessions": len({o[1] for o in obs if len(o) >= 3}),
        "observed_blocked_events": len([o for o in obs if len(o) >= 3 and o[2] == "blocked"]),
        "spend_usd": round(total_spend, 4),
        "spend_today_usd": round(today_spend, 4),
    })
    return res


def render(r) -> str:
    def med(x):
        return str(int(x)) if float(x).is_integer() else f"{x:.1f}"
    return "\n".join([
        f"{'threads':<28}{r['threads']:>4}   (forks {r['forks']})",
        f"{'turns per thread':<28}median {med(r['turns_median'])}, max {r['turns_max']}",
        f"{'threads with 6+ turns':<28}{r['threads_6plus']:>4}",
        f"{'  with a context edit':<28}{r['threads_6plus_with_context_edit']:>4}   ({r['context_edit_pct']:.1f}%)    H1 go >= 20%, kill < 5%",
        f"{'forks':<28}{r['forks']:>4}            H2 go >= 5,   kill < 2",
        f"{'  carry size':<28}median {med(r['carry_median_lines'])} lines / {r['carry_median_chars']/1000:.1f}k chars",
        f"{'model switches':<28}{r['model_switches']:>4}",
        f"{'searches (agent-files-grep)':<28}{r['searches']:>3}   H3: \"used\" count is in the journal",
        f"{'observed sessions':<28}{r['observed_sessions']:>4}   blocked events {r['observed_blocked_events']}",
        f"{'spend':<28}${r['spend_usd']:.2f} (today ${r['spend_today_usd']:.2f})",
    ])


def main():
    ap = argparse.ArgumentParser(prog="agent-files-stats")
    ap.add_argument("--since")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    root = fsutil.default_root()
    fsutil.check_root(root)
    r = compute(root, a.since)
    print(json.dumps(r, indent=2) if a.json else render(r))


if __name__ == "__main__":
    main()
