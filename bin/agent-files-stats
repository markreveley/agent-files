#!/usr/bin/env python3
"""agent-files-stats — threads, turns per thread, spend per day and per thread, live observed
sessions. Spend is the cost_usd in each steps/*.response.json, dated by the file's local mtime
(as the daily spend cap counts it). Standard library only."""
import argparse
import json
import os
import re
import statistics
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from agent_files import fsutil  # noqa: E402
from agent_files import thread as T  # noqa: E402


def spend(root, since=None):
    """(by_day, by_thread) in USD. Thread ids are relative to threads/; observed sessions never spend."""
    by_day, by_thread = {}, {}
    base = os.path.join(root, "threads")
    for dirpath, _, files in os.walk(base):
        if os.path.basename(dirpath) != "steps":
            continue
        tid = os.path.relpath(os.path.dirname(dirpath), base).replace(os.sep, "/")
        for fn in files:
            if not fn.endswith(".response.json"):
                continue
            p = os.path.join(dirpath, fn)
            try:
                day = time.strftime("%Y-%m-%d", time.localtime(os.path.getmtime(p)))
                with open(p, encoding="utf-8") as f:
                    c = float(json.load(f).get("cost_usd") or 0)
            except (OSError, ValueError, AttributeError):
                continue
            if since and day < since:
                continue
            by_day[day] = by_day.get(day, 0.0) + c
            by_thread[tid] = by_thread.get(tid, 0.0) + c
    return by_day, by_thread


def compute(root, since=None):
    nturns, observed = {}, {}
    for tid, d, _ in fsutil.list_threads(root, include_observed=True):
        if tid.startswith("_observed/"):
            observed[tid] = fsutil.read_status(d) or "unknown"
            continue
        try:
            th = T.parse_file(os.path.join(d, "thread.md"))
        except OSError:
            continue
        nturns[tid] = len([t for t in th.turns if t.role in ("you", "agent") and t.body.strip()])
    counts = sorted(nturns.values())
    by_day, by_thread = spend(root, since)
    today = time.strftime("%Y-%m-%d")
    by_status = {}
    for s in observed.values():
        by_status[s] = by_status.get(s, 0) + 1
    return {
        "threads": len(nturns),
        "turns_median": statistics.median(counts) if counts else 0,
        "turns_max": counts[-1] if counts else 0,
        "spend_usd": round(sum(by_day.values()), 4),
        "spend_today_usd": round(by_day.get(today, 0.0), 4),
        "spend_by_day_usd": {k: round(v, 4) for k, v in sorted(by_day.items())},
        "spend_by_thread_usd": {k: round(v, 4) for k, v in sorted(by_thread.items(), key=lambda kv: (-kv[1], kv[0]))},
        "observed_sessions": len(observed),
        "observed_by_status": dict(sorted(by_status.items())),
    }


def render(r) -> str:
    def med(x):
        return str(int(x)) if float(x).is_integer() else f"{x:.1f}"
    out = [
        f"{'threads':<28}{r['threads']:>4}",
        f"{'turns per thread':<28}median {med(r['turns_median'])}, max {r['turns_max']}",
        f"{'spend':<28}${r['spend_usd']:.2f} (today ${r['spend_today_usd']:.2f})",
    ]
    out += [f"  {d:<26}${v:.2f}" for d, v in r["spend_by_day_usd"].items()]
    if r["spend_by_thread_usd"]:
        out.append("spend per thread")
        out += [f"  {t:<26}${v:.2f}" for t, v in r["spend_by_thread_usd"].items()]
    st = ", ".join(f"{k} {v}" for k, v in r["observed_by_status"].items())
    out.append(f"{'observed sessions':<28}{r['observed_sessions']:>4}" + (f"   ({st})" if st else ""))
    return "\n".join(out)


def main():
    ap = argparse.ArgumentParser(prog="agent-files-stats")
    ap.add_argument("--since", help="count spend from this local date (YYYY-MM-DD) on")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    if a.since and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", a.since):
        ap.error("--since takes YYYY-MM-DD")
    root = fsutil.default_root()
    fsutil.check_root(root)
    r = compute(root, a.since)
    print(json.dumps(r, indent=2) if a.json else render(r))


if __name__ == "__main__":
    main()
