#!/bin/sh
# agent-files-grep <pattern> [rg options...] — rg over thread.md files (spec §8).
set -u
[ $# -ge 1 ] || { echo "usage: agent-files-grep <pattern> [rg options...]" >&2; exit 2; }
ROOT="${AGENT_FILES_ROOT:-$HOME/agent-files}"
PATTERN="$1"; shift
exec rg --vimgrep "$@" --glob thread.md --glob '!_observed/**' -e "$PATTERN" "$ROOT/threads"
